{
  "name": "lastlib-ui-components",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/lastlib-ui-components/lastlib-ui-components.esm.js",
  "exports": {
    ".": {
      "import": "./dist/lastlib-ui-components/lastlib-ui-components.esm.js",
      "require": "./dist/lastlib-ui-components/lastlib-ui-components.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stenciljs/component-starter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "pnpm tailwind:build && stencil build",
    "start": "stencil build --dev --watch --serve",
    "dev": "pnpm build && concurrently \"pnpm stencil:watch\" \"pnpm tailwind:watch\" \"pnpm storybook\"",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "tailwind:build": "tailwindcss -i ./src/global/tailwind.css -o ./src/global/tailwind.generated.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/global/tailwind.css -o ./src/global/tailwind.generated.css --watch",
    "stencil:watch": "stencil build --dev --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@stencil-community/postcss": "^2.2.0",
    "@stencil/angular-output-target": "^1.4.1",
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/vitest": "^1.8.3",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "concurrently": "^10.0.5",
    "lit": "^3.3.3",
    "playwright": "^1.52.0",
    "postcss": "^8.5.26",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
